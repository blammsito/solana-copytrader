{
  "name": "solana-copytrader",
  "version": "0.1.0",
  "private": true,
  "description": "Copy-trading bot that mirrors SOL->token buys from a watchlist of Solana wallets, with pre-buy risk checks and spend limits. Dry-run by default.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "report": "ts-node src/report.ts",
    "vet-wallets": "ts-node src/vetSniperWallets.ts",
    "conviction-report": "ts-node src/convictionReport.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.3",
    "bs58": "^5.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22"
  }
}
