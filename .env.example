# ==== Mode ====
# Must be explicitly set to "false" to enable live trading. Defaults to true.
DRY_RUN=true

# ==== Helius ====
HELIUS_API_KEY=your_helius_api_key
# Optional but recommended: set this in the Helius webhook config too, and
# the bot will reject any webhook POST that doesn't send it as the
# Authorization header.
HELIUS_WEBHOOK_SECRET=choose_a_random_secret
# Defaults to https://mainnet.helius-rpc.com/?api-key=<HELIUS_API_KEY> if unset
HELIUS_RPC_URL=

# Port the local webhook server listens on (point ngrok at this)
WEBHOOK_PORT=8080

# ==== Hold/release control API (controlServer.ts) ====
# Required to use the hold feature at all — without it, every request to
# /positions and /positions/:mint/hold|release is refused. Set this to a
# long random string; it's checked against Authorization: Bearer <secret>
# or a ?key= query param.
CONTROL_API_SECRET=

# ==== Own-trader entry strategy ====
# Required. Get a free account + API key at https://pumpportal.fun, then fund
# the linked wallet with a small amount of SOL (0.02+) — new-launch events
# are free, but per-token trade/volume tracking is metered.
PUMPPORTAL_API_KEY=
# Seconds after launch to keep counting buys/volume before giving up on a
# token that never caught on.
MOMENTUM_WINDOW_SEC=20
# Minimum buy count within the window to count as real momentum.
MOMENTUM_MIN_BUYS=10
# Minimum SOL buy volume within the window (required alongside the buy count).
MOMENTUM_MIN_VOLUME_SOL=4
# Hard-reject (in conviction.ts) if fewer than this many distinct wallets
# made up the buy activity — the "holder-backed" gate. MOMENTUM_MIN_BUYS
# alone can be satisfied by 2-3 wallets buying repeatedly.
MOMENTUM_MIN_UNIQUE_BUYERS=6
# Max number of just-launched tokens tracked concurrently (bounds cost).
MOMENTUM_MAX_CONCURRENT=40

# ==== Conviction scoring (conviction.ts) ====
# Position size scales between these bounds based on a 0-1 conviction score.
MIN_POSITION_SIZE_SOL=0.03
MAX_POSITION_SIZE_SOL=0.08
# Hard-reject if the creator wallet holds more than this fraction of supply.
MAX_CREATOR_HOLDING_PCT=0.05
# Hard-reject if holders ranked #2-#11 hold more than this fraction of supply.
MAX_TOP_HOLDER_CONCENTRATION_PCT=0.3
# Hard-reject if more than this fraction of buy volume is round-tripping
# (same-wallet buy-then-sell) wallets — a wash-trading signal.
MAX_ROUND_TRIP_VOLUME_SHARE_PCT=0.5

# ==== Legacy: wallets to copy (unused by default now — see launchMonitor.ts) ====
# Comma-separated list of Solana wallet addresses to mirror.
TARGET_WALLETS=

# ==== Trading ====
# Base58-encoded private key of the trading wallet. Required only when DRY_RUN=false.
WALLET_PRIVATE_KEY=

# Hard rolling 24h spend cap, across all buys
DAILY_SPEND_CAP_SOL=0.5
# Won't re-buy the same mint within this many minutes
DUPLICATE_BUY_WINDOW_MIN=10
# Minimum acceptable liquidity depth proxy (see README)
MIN_LIQUIDITY_USD=5000
MAX_SLIPPAGE_BPS=300

JUPITER_API_URL=https://quote-api.jup.ag/v6

# ==== State persistence ====
# positions.json / trades.json / spend-state.json all default to living
# under /data if that directory exists (a Railway Volume mounted there),
# otherwise the working directory. Railway's container filesystem outside
# a mounted volume is wiped on every restart/redeploy — without a volume,
# every deploy silently forgets any position the bot hasn't closed yet
# (the wallet still holds the tokens; the bot just loses track of them and
# never sells). On Railway: attach a Volume to this service mounted at
# /data and leave these three unset — no override needed. Only set them
# explicitly to force a different location.
POSITIONS_STATE_FILE=
TRADE_LEDGER_FILE=
SPEND_STATE_FILE=

# ==== Exit strategy ====
# Full-position exit at this much profit (ratio, e.g. 0.5 = +50%).
TAKE_PROFIT_PCT=0.5
# Full-position exit at this much loss, only while the trailing stop below
# hasn't armed yet.
STOP_LOSS_PCT=0.2
# Seconds after entry during which stop-loss can't trigger (early pump.fun
# price noise, including our own entry's impact, would otherwise false-stop).
STOP_LOSS_GRACE_SEC=45
# Force-close any position still open after this many minutes, regardless of P&L.
MAX_HOLD_MINUTES=60
# How often exitManager re-checks every open position.
EXIT_CHECK_INTERVAL_SEC=30
# Once profit ever reaches this ratio, STOP_LOSS_PCT stops applying and a
# trailing stop takes over instead (see TRAILING_STOP_PCT).
TRAILING_STOP_ARM_PCT=0.2
# Once armed, exit if price pulls back this much (ratio) from its peak.
TRAILING_STOP_PCT=0.15
# Sell PARTIAL_SCALE_OUT_FRACTION of the position once profit first reaches
# this ratio, banking that portion's profit; the remainder rides with a
# breakeven-or-better floor plus the trailing stop above. 0 disables this.
PARTIAL_TAKE_PROFIT_PCT=0.3
# Fraction of the position sold at the partial take-profit trigger.
PARTIAL_SCALE_OUT_FRACTION=0.5
